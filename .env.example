# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/pepeshops?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
NEXTAUTH_SECRET="your-nextauth-secret-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Admin Seed
ADMIN_EMAIL="admin@pepeshops.com"
ADMIN_PASSWORD="admin123456"
ADMIN_NAME="System Admin"

# Server Port (automatically set by hosting platform, default 3000)
PORT=3000

# Worker Config
POLLING_INTERVAL_MS=200
CAMPAIGN_TIMEOUT_MINUTES=5
POLLING_START_BEFORE_SECONDS=120
